# Twelve Data free-tier API key — https://twelvedata.com (signup only, no
# account approval/region restriction like OANDA's). This is the DEFAULT
# forex data source used by fetch_candles.py.
TWELVE_DATA_API_KEY=

# OANDA practice account — https://developer.oanda.com. Kept for possible
# future use (its account-scoped endpoints matter from Phase 6 live
# execution onward regardless of data source) but NOT required for
# fetch_candles.py's default forex path, which uses Twelve Data instead.
# OANDA does not accept account signups from every country.
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice   # practice | live

# Kraken's public OHLC endpoint needs no API key or account.

SIGNALFORGE_DB_PATH=data/signalforge.db
LOG_LEVEL=INFO
