# OANDA practice account — https://developer.oanda.com
OANDA_API_TOKEN=
# Not used by the Phase 1 candles adapter (account-scoped endpoints only,
# e.g. Phase 6 live execution) — captured here now so it's not missing later.
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice   # practice | live

# Optional: CoinGecko Demo API key for a higher rate limit. Not required —
# the public OHLC endpoint works without auth.
COINGECKO_API_KEY=

SIGNALFORGE_DB_PATH=data/signalforge.db
LOG_LEVEL=INFO
